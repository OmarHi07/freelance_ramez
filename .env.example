# Copy to .env for local development:  cp .env.example .env
# Never commit your real .env file. Production values belong in the hosting dashboard.

# --- Django -----------------------------------------------------------------
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
# Comma separated, e.g. rawnaq.example,www.rawnaq.example,your-app.up.railway.app
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Full origins with scheme, e.g. https://rawnaq.example,https://www.rawnaq.example
DJANGO_CSRF_TRUSTED_ORIGINS=
# Public site address used in the owner link inside WhatsApp messages (no trailing slash)
SITE_URL=http://localhost:8000
DJANGO_LOG_LEVEL=INFO

# --- Database (PostgreSQL, psycopg 3) ----------------------------------------
# Local:  postgres://USER:PASSWORD@localhost:5432/DBNAME
DATABASE_URL=postgres://rawnaq:change-me-locally@localhost:5432/rawnaq
DATABASE_CONN_MAX_AGE=60

# --- Production security (used by config.settings.production) ----------------
DJANGO_SECURE_SSL_REDIRECT=True
# Start small (3600), raise to 31536000 once HTTPS is confirmed on every subdomain.
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
# Number of reverse proxies in front of the app (Render/Railway: 1, local: 0)
TRUSTED_PROXY_COUNT=0

# --- Login throttling (django-axes) -------------------------------------------
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=15

# --- Email (password reset) ----------------------------------------------------
# consolemail:// prints emails to the console. Production example:
# EMAIL_URL=smtp+tls://USERNAME:PASSWORD@smtp.example.com:587
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=rawnaq_accessories1 <no-reply@localhost>

# --- Media storage ---------------------------------------------------------------
# local | s3 | cloudinary   (images are always stored in the storage backend, never in PostgreSQL)
MEDIA_STORAGE_BACKEND=local
MEDIA_URL=/media/
# Serve local media with Django when DEBUG=False (single server with a persistent disk only)
DJANGO_SERVE_MEDIA_FILES=False
MAX_IMAGE_UPLOAD_MB=5
# Extra image origins for the Content-Security-Policy, e.g. https://media.rawnaq.example
CSP_EXTRA_IMG_SRC=

# S3-compatible storage (AWS S3, Cloudflare R2, Backblaze B2, DigitalOcean Spaces, MinIO)
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION_NAME=
S3_ENDPOINT_URL=
S3_CUSTOM_DOMAIN=
S3_MEDIA_LOCATION=media
S3_QUERYSTRING_AUTH=False

# Cloudinary (requires: pip install -r requirements-cloudinary.txt)
CLOUDINARY_URL=

# --- Store -------------------------------------------------------------------------
LOW_STOCK_THRESHOLD=3
ORDER_NOTIFIER_BACKEND=orders.services.notifications.ClickToChatNotifier

# --- Docker Compose (local PostgreSQL container) ---------------------------------------
POSTGRES_DB=rawnaq
POSTGRES_USER=rawnaq
POSTGRES_PASSWORD=change-me-locally
